# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Model Configuration
# Path to ONNX model relative to backend directory or absolute path
MODEL_PATH=models/best_model.onnx

# CORS Configuration
# Comma-separated list of allowed origins for the Next.js frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Upload and Processing Configuration
MAX_FILE_SIZE_MB=25
TARGET_SAMPLE_RATE=16000
CHUNK_DURATION_SEC=3
